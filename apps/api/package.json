    "@reso/config": "workspace:*",
    "@reso/contracts": "workspace:*",
    "fastify": "^5.12.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@reso/test-fixtures": "workspace:*",
    "@types/node": "^26.3.0",
    "tsx": "^4.23.12",
    "vitest": "^4.1.11"
  }
}
