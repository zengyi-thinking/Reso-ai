APP_ENV=development
WEB_PORT=5173
API_PORT=3000
AGENT_SERVICE_PORT=8000
PRODUCT_REPOSITORY=memory
SESSION_PROVIDER=demo

DATABASE_URL=postgresql://reso:reso@localhost:5432/reso
REDIS_URL=redis://localhost:6379/0
WORKER_POLL_MS=1000
WORKER_BATCH_SIZE=10

AGENT_SERVICE_URL=http://localhost:8000
AGENT_TIMEOUT_MS=15000
AGENT_SERVICE_TOKEN=

# Email-only authentication. Never commit real SMTP credentials.
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_AUTH_CODE=
SMTP_FROM=
AUTH_CODE_HASH_SECRET=
AUTH_CODE_TTL_SECONDS=600
AUTH_CODE_RESEND_SECONDS=60

# Real model only: the Product API and Agent Service always use MiniMax.
# Missing or invalid configuration fails fast at startup; there is no substitute provider.
LLM_PROVIDER=minimax
LLM_MODEL=MiniMax-M3
LLM_API_KEY=
LLM_BASE_URL=https://api.minimax.io/v1
# Optional. When set, memory retrieval blends cosine similarity into the lexical
# baseline (embeddings are computed only inside the Agent Service). When unset,
# everything stays on the free lexical baseline - never fake vectors.
LLM_EMBEDDING_MODEL=
# Worker reflects over a conversation once this many user messages accumulate
# after the last reflection watermark.
WORKER_REFLECTION_THRESHOLD=4

TRACE_ENABLED=false
LOG_LEVEL=info
